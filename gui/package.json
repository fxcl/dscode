{
  "name": "dscode-gui",
  "version": "0.3.5",
  "description": "A Codex-style GUI for DSCode (dscode CLI).",
  "author": "DSCode Team",
  "private": true,
  "main": "dist-electron/main/index.js",
  "scripts": {
    "predev": "node -e \"require('node:fs').existsSync('../packages/core/dist/index.js') || process.exit(1)\" || echo 'WARNING: packages/core not built. Run pnpm build:core first.'",
    "prebuild": "node -e \"require('node:fs').existsSync('../packages/core/dist/index.js') || process.exit(1)\" || echo 'WARNING: packages/core not built. Run pnpm build:core first.'",
    "dev": "ELECTRON_RUN_AS_NODE= electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder",
    "typecheck": "tsc --noEmit",
    "test": "VITE_CJS_IGNORE_WARNING=true vitest run",
    "test:dscode": "VITE_CJS_IGNORE_WARNING=true vitest run --config vitest.dscode.config.ts",
    "test:dscode:live": "DSCODE_GUI_RUN_LIVE_TESTS=1 VITE_CJS_IGNORE_WARNING=true vitest run --config vitest.dscode.live.config.ts",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "@thinkany/dscode-core": "link:../packages/core",
    "lucide-react": "^0.454.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.27.0",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.0",
    "mermaid": "11.16.1"
  },
  "build": {
    "appId": "com.thinkany.dscode-gui",
    "productName": "DSCode GUI",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/main/**",
      "dist-electron/preload/**",
      "dist-electron/renderer/**",
      "dist-electron/package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Development"
    }
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
